{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/apps-page.js": {
      "includeFiles": "api/_apps.html"
    },
    "api/admin-page.js": {
      "includeFiles": "api/_admin.html"
    }
  },
  "rewrites": [
    {
      "source": "/apps",
      "destination": "/api/apps-page"
    },
    {
      "source": "/apps/admin",
      "destination": "/api/admin-page"
    },
    {
      "source": "/admin",
      "destination": "/api/admin-page"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
