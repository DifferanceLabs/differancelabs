# All values below are server-only. Never put credentials in VITE_* variables.
ART_APP_MODE=demo
ART_APP_ORIGIN=http://localhost:5173
ART_EXPECTED_DATABASE_ID=
DL_PORTAL_ORIGIN=https://www.differancelabs.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required only in live mode; use the existing launch secret securely.
DL_APP_LAUNCH_SECRET=
# Local setup/migration/backup tools only; do not add this to Vercel runtime.
ART_MIGRATION_DATABASE_URL=
# Separate backup passphrase; store securely, never in Vercel.
ART_BACKUP_PASSPHRASE=
# Optional official Supabase CA certificate path for database tooling TLS.
ART_DATABASE_CA_PATH=
